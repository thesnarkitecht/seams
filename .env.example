# Seams configuration. Copy to .env and fill in. Leave TENANT_ID/CLIENT_ID empty to run on example data.

# --- The app registration (Microsoft Entra ID → App registrations). See docs/ENTRA.md. ---
TENANT_ID=
CLIENT_ID=
# A client secret, or a certificate (PEM with the private key and the certificate).
CLIENT_SECRET=
# CLIENT_CERT_PATH=/run/secrets/seams.pem

# Where people reach Seams. The redirect URI to register is PUBLIC_URL/auth/callback.
PUBLIC_URL=http://localhost:8090
HOST=127.0.0.1
PORT=8090

# Encrypts each person's Microsoft refresh token at rest. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SEAMS_SECRET_KEY=

# Optional: only these people may sign in (emails or UPNs, comma separated). Empty = anyone in the tenant.
ALLOWED_USERS=

# Presence sessions use the app's own token (application permission Presence.ReadWrite.All).
# Set to 0 to use each person's delegated Presence.ReadWrite instead.
APP_PRESENCE=1

DATA_DIR=./data
# SEAMS_DEMO=1   # force example data even when the app registration is set
